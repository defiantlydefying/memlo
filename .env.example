# Required
DISCORD_TOKEN=

# Optional: leave blank for the complete no-AI deadline workflow.
# Adding a key enables AI reading, answers, quizzes and grading after restart.
# Also enable Message Content Intent in the Discord Developer Portal for AI mode.
ANTHROPIC_API_KEY=

# Default offered during /setup; every Discord server stores its own timezone.
CLASS_TIMEZONE=America/Chicago

# Public Discord and policy links
DISCORD_INSTALL_URL=
PRIVACY_URL=https://getmemlo.com/privacy
TERMS_URL=https://getmemlo.com/terms
SUPPORT_SERVER_URL=https://discord.gg/7UT2aPf5Us

# Operations
BACKUP_DIR=backups
BACKUP_RETENTION=14
HEALTH_HOST=127.0.0.1
HEALTH_PORT=8080
LOG_PATH=memlo.log
